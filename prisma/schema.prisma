generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum Subject {
  MATH
  ENGLISH
}

enum MaterialKind {
  CLASS_PLAN
  HOMEWORK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model User {
  id                 String         @id @default(cuid())
  login              String         @unique
  displayName        String
  role               Role
  credentialHash     String
  accessCode         String?
  active             Boolean        @default(true)
  archivedAt         DateTime?
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime       @default(now())
  sessions           LoginSession[]
  studentAssignments Assignment[]   @relation("StudentAssignments")
  teacherAssignments Assignment[]   @relation("TeacherAssignments")
  materials          Material[]     @relation("MaterialAuthor")
}

model LoginSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A reusable template. Class plans are scheduled for a date; homework is assigned with a due date.
model Material {
  id          String       @id @default(cuid())
  kind        MaterialKind
  subject     Subject
  title       String
  summary     String       @default("") @db.Text
  topicIds    String[]     @default([])
  blocks      Json
  version     Int          @default(1)
  authorId    String
  author      User         @relation("MaterialAuthor", fields: [authorId], references: [id])
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]

  @@index([kind, archivedAt])
}

/// One material handed to one student. `blocks` is a snapshot taken at assign time,
/// so editing or archiving the source material can never corrupt submitted work.
model Assignment {
  id                String       @id @default(cuid())
  studentId         String
  student           User         @relation("StudentAssignments", fields: [studentId], references: [id])
  teacherId         String
  teacher           User         @relation("TeacherAssignments", fields: [teacherId], references: [id])
  materialId        String?
  material          Material?    @relation(fields: [materialId], references: [id])
  materialVersion   Int          @default(1)
  kind              MaterialKind
  subject           Subject
  title             String
  summary           String       @default("") @db.Text
  blocks            Json
  availableAt       DateTime     @default(now())
  scheduledAt       DateTime?
  dueAt             DateTime?
  attendedAt        DateTime?
  maxAttempts       Int          @default(1)
  notes             String       @default("") @db.Text
  notesPublishedAt  DateTime?
  archivedAt        DateTime?
  classAssignmentId String?
  classAssignment   Assignment?  @relation("ClassWork", fields: [classAssignmentId], references: [id])
  linkedWork        Assignment[] @relation("ClassWork")
  createdAt         DateTime     @default(now())
  attempts          Attempt[]

  @@index([studentId, kind, availableAt])
  @@index([studentId, scheduledAt])
  @@index([studentId, dueAt])
  @@index([classAssignmentId])
}

model Attempt {
  id           String        @id @default(cuid())
  assignmentId String
  assignment   Assignment    @relation(fields: [assignmentId], references: [id])
  number       Int
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  deletedAt    DateTime?
  responses    Response[]

  @@unique([assignmentId, number])
  @@index([deletedAt])
}

model Response {
  id         String    @id @default(cuid())
  attemptId  String
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  answer     String    @default("") @db.Text
  score      Int?
  maxPoints  Int
  feedback   String    @default("") @db.Text
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([attemptId, questionId])
}
